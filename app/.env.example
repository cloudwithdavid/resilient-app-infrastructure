# Non-secret configuration only. Copy to app/.env, edit, then source explicitly.
# Database credentials are retrieved from Secrets Manager using the EC2 IAM role.
export AWS_REGION='us-east-1'
export DB_SECRET_ID='replace-with-secret-arn'
export DB_HOST='replace-with-rds-endpoint'
export DB_NAME='portfolio_validation'
export DB_PORT='3306'
export DB_CA_BUNDLE='/absolute/path/to/rds-ca-bundle.pem'
